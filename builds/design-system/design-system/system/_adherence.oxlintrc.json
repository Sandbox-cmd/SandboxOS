{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/cartridge/**",
              "components/core/**",
              "components/forms/**",
              "components/stickers/**",
              "lib/**",
              "ui_kits/mobile/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Archivo|Anton|JetBrains Mono|VT323|Silkscreen))/i]",
        "message": "Font not provided by the design system. Available: Archivo, Anton, JetBrains Mono, VT323, Silkscreen."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:face|initials|size|status|serial|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: face, initials, size, status, serial."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:online|building|away|rebel)$/]",
        "message": "<Avatar> status must be one of 'online' | 'building' | 'away' | 'rebel'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BootCoin'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|label|serial|glyph|tone|spin|key|ref|className|style|children)$/]",
        "message": "<BootCoin> doesn't accept that prop. Declared props: size, label, serial, glyph, tone, spin."
      },
      {
        "selector": "JSXOpeningElement[name.name='BootCoin'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:amber|rebel|green|cyan)$/]",
        "message": "<BootCoin> tone must be one of 'amber' | 'rebel' | 'green' | 'cyan'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Cartridge'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|subtitle|serial|kind|spineStyle|spin|width|key|ref|className|style|children)$/]",
        "message": "<Cartridge> doesn't accept that prop. Declared props: title, subtitle, serial, kind, spineStyle, spin, width."
      },
      {
        "selector": "JSXOpeningElement[name.name='Cartridge'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:build|skill|persona)$/]",
        "message": "<Cartridge> kind must be one of 'build' | 'skill' | 'persona'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CharacterSlap'] > JSXAttribute > JSXIdentifier[name!=/^(?:face|label|tone|rotate|key|ref|className|style|children)$/]",
        "message": "<CharacterSlap> doesn't accept that prop. Declared props: face, label, tone, rotate."
      },
      {
        "selector": "JSXOpeningElement[name.name='CharacterSlap'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:rebel|cool|go|hazard)$/]",
        "message": "<CharacterSlap> tone must be one of 'rebel' | 'cool' | 'go' | 'hazard'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|label|disabled|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: checked, onChange, label, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='DialogAction'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|onClick|tone|key|ref|className|style|children)$/]",
        "message": "<DialogAction> doesn't accept that prop. Declared props: label, onClick, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='DialogAction'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|ghost|go|rebel|ok|danger)$/]",
        "message": "<DialogAction> tone must be one of 'default' | 'ghost' | 'go' | 'rebel' | 'ok' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FaceToggle'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|faces|key|ref|className|style|children)$/]",
        "message": "<FaceToggle> doesn't accept that prop. Declared props: checked, onChange, faces."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|prefix|key|ref|className|style|children)$/]",
        "message": "<Field> doesn't accept that prop. Declared props: label, prefix."
      },
      {
        "selector": "JSXOpeningElement[name.name='GhostEye'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|accent|mood|watch|blink|key|ref|className|style|children)$/]",
        "message": "<GhostEye> doesn't accept that prop. Declared props: size, accent, mood, watch, blink."
      },
      {
        "selector": "JSXOpeningElement[name.name='GhostEye'] > JSXAttribute[name.name='mood'] > Literal[value!=/^(?:rebel|calm|watch)$/]",
        "message": "<GhostEye> mood must be one of 'rebel' | 'calm' | 'watch'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Knob'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|defaultValue|min|max|label|size|accent|onChange|key|ref|className|style|children)$/]",
        "message": "<Knob> doesn't accept that prop. Declared props: value, defaultValue, min, max, label, size, accent, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='Loader'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|caption|width|key|ref|className|style|children)$/]",
        "message": "<Loader> doesn't accept that prop. Declared props: value, label, caption, width."
      },
      {
        "selector": "JSXOpeningElement[name.name='SelectOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|key|ref|className|style|children)$/]",
        "message": "<SelectOption> doesn't accept that prop. Declared props: label, value."
      },
      {
        "selector": "JSXOpeningElement[name.name='SlapButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|size|block|rotate|disabled|key|ref|className|style|children)$/]",
        "message": "<SlapButton> doesn't accept that prop. Declared props: tone, size, block, rotate, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='SlapButton'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|ghost|go|rebel|ok|danger)$/]",
        "message": "<SlapButton> tone must be one of 'default' | 'ghost' | 'go' | 'rebel' | 'ok' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SlapButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<SlapButton> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Sticker'] > JSXAttribute > JSXIdentifier[name!=/^(?:shape|tone|rotate|halo|size|key|ref|className|style|children)$/]",
        "message": "<Sticker> doesn't accept that prop. Declared props: shape, tone, rotate, halo, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='Sticker'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:tag|pill|seal|burst|ribbon|price|callout|stamp)$/]",
        "message": "<Sticker> shape must be one of 'tag' | 'pill' | 'seal' | 'burst' | 'ribbon' | 'price' | 'callout' | 'stamp'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Sticker'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:hazard|alert|rebel|go|cyan|ink|paper|striped)$/]",
        "message": "<Sticker> tone must be one of 'hazard' | 'alert' | 'rebel' | 'go' | 'cyan' | 'ink' | 'paper' | 'striped'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Sticker'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Sticker> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Switch'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|label|disabled|accent|key|ref|className|style|children)$/]",
        "message": "<Switch> doesn't accept that prop. Declared props: checked, onChange, label, disabled, accent."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tabs'] > JSXAttribute > JSXIdentifier[name!=/^(?:tabs|value|onChange|key|ref|className|style|children)$/]",
        "message": "<Tabs> doesn't accept that prop. Declared props: tabs, value, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|tone|glyph|key|ref|className|style|children)$/]",
        "message": "<Toast> doesn't accept that prop. Declared props: title, tone, glyph."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:rebel|alert|ok|info|warn)$/]",
        "message": "<Toast> tone must be one of 'rebel' | 'alert' | 'ok' | 'info' | 'warn'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tooltip'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|tone|side|key|ref|className|style|children)$/]",
        "message": "<Tooltip> doesn't accept that prop. Declared props: label, tone, side."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tooltip'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:ink|amber|rebel)$/]",
        "message": "<Tooltip> tone must be one of 'ink' | 'amber' | 'rebel'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tooltip'] > JSXAttribute[name.name='side'] > Literal[value!=/^(?:top|bottom)$/]",
        "message": "<Tooltip> side must be one of 'top' | 'bottom'."
      },
      {
        "selector": "JSXOpeningElement[name.name='VHSHeadline'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|size|align|liveWords|accent|split|shadow|key|ref|className|style|children)$/]",
        "message": "<VHSHeadline> doesn't accept that prop. Declared props: children, size, align, liveWords, accent, split, shadow."
      },
      {
        "selector": "JSXOpeningElement[name.name='VHSHeadline'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:lg|xl|2xl)$/]",
        "message": "<VHSHeadline> size must be one of 'lg' | 'xl' | '2xl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='VHSHeadline'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center|right)$/]",
        "message": "<VHSHeadline> align must be one of 'left' | 'center' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Window'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|tone|width|tilt|footer|onClose|key|ref|className|style|children)$/]",
        "message": "<Window> doesn't accept that prop. Declared props: title, tone, width, tilt, footer, onClose."
      },
      {
        "selector": "JSXOpeningElement[name.name='Window'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:mono|blue)$/]",
        "message": "<Window> tone must be one of 'mono' | 'blue'."
      }
    ]
  },
